# SDE Preparation Portal Backend Configuration
# Rename this file to '.env' inside the backend folder and populate the credentials.

# --- LLM API Configurations ---
# Google Gemini key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI key from OpenAI Platform Dashboard: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Project Database Endpoint and Anon Key (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
